<com.termux.app.terminal.SessionRowView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/avic_session_inset"
    android:paddingStart="@dimen/avic_session_padding" android:paddingEnd="@dimen/avic_session_padding" android:paddingTop="16dp" android:paddingBottom="16dp">
    <TextView android:id="@+id/session_number" android:layout_width="40dp" android:layout_height="40dp"
        android:gravity="center" android:fontFamily="monospace" android:textSize="16sp"
        android:textColor="@color/avic_session_number" android:background="@drawable/avic_session_badge"
        android:duplicateParentState="true" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:paddingStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/session_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/avic_text" />
        <TextView android:id="@+id/session_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/avic_muted" android:layout_marginTop="4dp" />
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginStart="8dp" android:src="@drawable/ic_avic_check" app:tint="@color/avic_session_check"
        android:duplicateParentState="true" android:importantForAccessibility="no" />
</com.termux.app.terminal.SessionRowView>
