<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/avic_ripple">
    <item><selector>
        <item android:state_activated="true"><shape><solid android:color="@color/avic_selected" /><corners android:radius="12dp" /><stroke android:width="1dp" android:color="@color/avic_selected_line" /></shape></item>
        <item android:state_focused="true"><shape><solid android:color="@color/avic_raised" /><corners android:radius="12dp" /><stroke android:width="2dp" android:color="@color/avic_teal" /></shape></item>
        <item><shape><solid android:color="@color/avic_raised" /><corners android:radius="12dp" /></shape></item>
    </selector></item>
</ripple>
